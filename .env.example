# ── PayPal sandbox ─────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app (enable Payouts)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Printed by: pnpm webhook:register https://<public-url>
PAYPAL_WEBHOOK_ID=

# ── Sandbox accounts (Testing Tools → Sandbox Accounts, US) ────
SANDBOX_BUYER_EMAIL=
# The business account that owns the PayPal app (Haggle itself). Payouts to it fail with SELF_PAY_NOT_ALLOWED.
SANDBOX_PLATFORM_EMAIL=
# Other sandbox Business accounts that receive merchant payouts (comma separated)
SANDBOX_MERCHANT_EMAILS=

# ── AI ─────────────────────────────────────────────────────────
# google (free key: aistudio.google.com/apikey) | anthropic | none (deterministic fallback)
LLM_PROVIDER=google
# Comma-separate keys from several free projects to multiply quota
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Optional comma-separated model chains overriding the defaults
LLM_FAST_MODEL=
LLM_SMART_MODEL=

# ── App ────────────────────────────────────────────────────────
DATABASE_URL=postgres://haggle:haggle@localhost:5433/haggle
DEMO_MODE=true
# openssl rand -hex 32
MANDATE_SIGNING_SECRET=
