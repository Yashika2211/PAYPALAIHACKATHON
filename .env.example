# PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Sandbox test accounts (developer.paypal.com -> Testing Tools -> Sandbox Accounts)
SANDBOX_BUYER_EMAIL=
SANDBOX_MERCHANT_EMAILS=caterer@example.com,bakery@example.com,print@example.com,florist@example.com

# Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# App
DATABASE_URL=postgres://haggle:haggle@localhost:5433/haggle
DEMO_MODE=true
MANDATE_SIGNING_SECRET=change-me
